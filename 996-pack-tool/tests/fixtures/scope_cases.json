    {
      "id": "sensitive_local_reflection",
      "policy": "reject_or_preserve_affected_scope",
      "encoding": "utf-8",
      "source": "local secret = 7\nlocal found = false\nfor i = 1, 20 do\n    local name, value = debug.getlocal(1, i)\n    if name == \"secret\" then found = value; break end\nend\nreturn found",
      "expected": 7,
      "protected_globals": [
        "debug"
      ],
      "protected_fields": [
        "getlocal"
      ],
      "protected_string_values": [
        "secret"
      ],
      "note": "Do not blindly rename observed locals; rejection must identify the file/scope. Baseline must return 7."
    }
