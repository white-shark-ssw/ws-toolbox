{
  "schema": "ws-lua-scope-cases-v1",
  "purpose": "Test inputs and baseline results; not a production rename whitelist, not a working obfuscator.",
  "cases": [
    {
      "id": "local_alias_of_global",
      "policy": "rename_safe",
      "encoding": "utf-8",
      "source": "GameData = {Object = {value = 7}}\nlocal GameData = GameData\nreturn GameData.Object.value",
      "expected": 7,
      "protected_globals": [
        "GameData"
      ],
      "protected_fields": [
        "Object",
        "value"
      ],
      "protected_string_values": [],
      "note": "Initializer RHS is global; subsequent bound GameData is local."
    },
    {
      "id": "initializer_outer_binding",
